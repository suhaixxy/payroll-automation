# Copy backend settings to a repository-root .env file. Copy the VITE_* settings
# to frontend/.env because Vite loads environment files from frontend/.
# Never commit either .env file.

NODE_ENV=development

# PostgreSQL 16 local Docker defaults (docker-compose.yml)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=payroll_automation
DB_USER=postgres
DB_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/payroll_automation

# Backend
PORT=5000
FRONTEND_URL=http://localhost:5173
GENERATE_PAY_PERIODS_ON_STARTUP=false

# Authentication: replace the secret locally and in every deployed environment.
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=8h

# UC-001 roster source (published Google Sheet CSV URL)
ROSTER_SHEET_CSV_URL=

# UC-003 variance-warning fraction; 0.15 means 15%.
UC003_VARIANCE_THRESHOLD=0.15

# UC-005 integration and payslip output
HRMS_MODE=mock
HRMS_SIMULATE_FAILURE=false
COMPANY_NAME=Emergencies First Aid & Rescue

# Frontend API origin. VITE_API_URL is a supported fallback; normally set only
# VITE_BACKEND_URL so all API modules use one explicit value.
VITE_BACKEND_URL=http://localhost:5000
VITE_API_URL=http://localhost:5000

# Development seed passwords (replace before running seeds locally).
SEED_MANAGER_PASSWORD=replace_with_manager_password
SEED_EMPLOYEE_PASSWORD=replace_with_employee_password
SEED_DISABLED_PASSWORD=replace_with_disabled_password
