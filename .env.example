# Copy this file to .env at the repo root, unchanged. .env is gitignored.
# The database values below are fixed by the team's docker-compose.yml so every
# teammate's connection string is identical — do not edit them.

NODE_ENV=development

# ── PostgreSQL 16 (Docker container, started with: npm run db:up) ──────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=payroll_automation
DB_USER=postgres
DB_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/payroll_automation

# ── Backend (Node + Express, runs on the host) ─────────────────────────────
# Port the backend listens on. The committed code defaults to 5000.
PORT=5000

# ── Authentication ─────────────────────────────────────────────────────────
# Secret used to sign JWT session tokens. Any long random string works
# locally; each teammate can use their own value.
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=8h

# ── Integrations ──────────────────────────────────────────────────────────
# UC-001 roster source: the Google Sheet published as CSV.
# In Google Sheets: File > Share > Publish to web > select the roster tab + CSV,
# then paste the generated link here.
ROSTER_SHEET_CSV_URL=

# HRMS mock integration
HRMS_MODE=mock
HRMS_SIMULATE_FAILURE=false

# ── Payslip ───────────────────────────────────────────────────────────────
COMPANY_NAME=Emergencies First Aid & Rescue

# ── Frontend / CORS ──────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
VITE_BACKEND_URL=http://localhost:5000

# ── Development seed passwords ────────────────────────────────────────────
SEED_MANAGER_PASSWORD=replace_with_manager_password
SEED_EMPLOYEE_PASSWORD=replace_with_employee_password
SEED_DISABLED_PASSWORD=replace_with_disabled_password
